# Copy to .env before: docker compose up -d --build
#
# cp .env.docker.example .env

PROXIMA_API_KEY=sk-change-me-proxima
PROXIMA_PROVIDER=chatgpt
PROXIMA_REST_PORT=3210
# MCP/IPC is off in Docker (REST only). ChatGPT-only keeps RAM under 512MB.

# --- Cookies: pick ONE style ---

# A) JSON (or base64 JSON) directly in env — works without mounting ./cookies
# Export via EditThisCookie / Cookie-Editor, then paste the array (or base64-encode it).
# PROXIMA_COOKIES_CHATGPT=[{"name":"...","value":"...","domain":".openai.com","path":"/","secure":true,"httpOnly":true,"sameSite":"no_restriction"}]
# PROXIMA_COOKIES_CLAUDE=[...]
# PROXIMA_COOKIES_GEMINI=[...]
# PROXIMA_COOKIES_PERPLEXITY=[...]
# Or all providers in one object:
# PROXIMA_COOKIES={"chatgpt":[...],"claude":[...]}

# B) Cookie files on the host (Compose mounts COOKIES_DIR → /cookies)
COOKIES_DIR=./cookies
# Default in-container paths (missing files are skipped):
# PROXIMA_COOKIES_CHATGPT_FILE=/cookies/chatgpt.json
# PROXIMA_COOKIES_CLAUDE_FILE=/cookies/claude.json
# PROXIMA_COOKIES_GEMINI_FILE=/cookies/gemini.json
# PROXIMA_COOKIES_PERPLEXITY_FILE=/cookies/perplexity.json
